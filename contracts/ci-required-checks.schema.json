{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monomer.cc/contracts/ci-required-checks/v1",
  "title": "Monomer required CI checks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "workflowName",
    "completionCheck",
    "requiredChecks",
    "unavailableChecks",
    "scopes",
    "fanOutRoots",
    "ciInfrastructureRoots"
  ],
  "properties": {
    "$schema": { "const": "./ci-required-checks.schema.json" },
    "schemaVersion": { "const": 1 },
    "workflowName": { "const": "CI" },
    "completionCheck": { "const": "ci / required" },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "unavailableChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/unavailableCheck" }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "fanOutRoots": { "$ref": "#/$defs/paths" },
    "ciInfrastructureRoots": { "$ref": "#/$defs/paths" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "checkName"],
      "properties": {
        "jobId": { "type": "string", "pattern": "^ci-[a-z0-9-]+$" },
        "checkName": { "type": "string", "minLength": 1 }
      }
    },
    "unavailableCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "checkName", "scope", "prerequisite"],
      "properties": {
        "jobId": { "type": "string", "pattern": "^ci-[a-z0-9-]+$" },
        "checkName": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "prerequisite": { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
