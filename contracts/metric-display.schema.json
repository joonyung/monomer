{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monomer.cc/schemas/metric-display.schema.json",
  "title": "Metric display",
  "description": "Execution-time metric presentation metadata. Formatting does not change exact result values.",
  "oneOf": [
    {
      "$ref": "#/$defs/number"
    },
    {
      "$ref": "#/$defs/currencyDisplay"
    },
    {
      "$ref": "#/$defs/percent"
    }
  ],
