    "unit": {
      "type": "string",
      "enum": [
        "percent",
        "second",
        "millisecond",
        "minute",
        "hour",
        "day",
        "byte",
        "kilobyte",
        "megabyte",
        "gigabyte"
      ]
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "decimals"
      ],
      "properties": {
        "style": {
          "const": "NUMBER"
        },
        "decimals": {
          "$ref": "#/$defs/decimals"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "currencyDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "decimals",
        "currency"
      ],
      "properties": {
        "style": {
          "const": "CURRENCY"
        },
        "decimals": {
          "$ref": "#/$defs/decimals"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      }
    },
    "percent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "decimals"
      ],
      "properties": {
        "style": {
          "const": "PERCENT"
        },
        "decimals": {
          "$ref": "#/$defs/decimals"
        }
      }
    }
  }
