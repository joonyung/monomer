{
  "name": "@monomer/web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=local vite --host 0.0.0.0",
    "check:logo-assets": "node ../scripts/generate-logo-assets.mjs --check",
    "generate:control-client": "node scripts/generate-control-client.mjs",
    "check:control-client": "node scripts/generate-control-client.mjs --check",
    "check:chart-source": "node scripts/check-chart-source.mjs",
    "check:patches": "node scripts/check-patches.mjs",
    "build": "npm run check:logo-assets && vite build && npm run typecheck",
    "build:mcp-view": "vite build --config vite.mcp-view.config.ts",
    "start": "vite preview --host 0.0.0.0 --port 3100",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package --error-on-fail --error-on-warn"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.1",
    "dompurify": "^3.4.14",
    "echarts": "6.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "monaco-editor": "0.53.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-markdown": "^10.1.0",
    "ses": "2.2.0",
    "simple-icons": "^16.21.0",
    "sucrase": "3.35.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-generator": "1.167.18",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "openapi-typescript": "7.13.0",
    "patch-package": "8.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    }
  }
}
