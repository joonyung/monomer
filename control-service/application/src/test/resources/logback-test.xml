<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="safeEx" class="cc.monomer.control.observability.MessageFreeThrowableConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %level %logger : %msg %kvp%n%safeEx</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
